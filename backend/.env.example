# Environment Configuration Template
# Copy this file to '.env' and fill in your actual API keys and preferences.

# 1. API Keys (Do NOT commit active keys to Git)
GEMINI_API_KEY=your_gemini_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. Pinecone Vector Database Config
PINECONE_INDEX_NAME=sentinel-ai

# 3. SQLite Local Database Path
DATABASE_URL=sqlite:///./sentinel_ai.db

# 4. Server Run Configurations
PORT=8000
HOST=127.0.0.1

# 5. Language Model Setup
GEMINI_MODEL=gemini-flash-lite-latest
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODEL_POOL=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3-coder:free,deepseek/deepseek-v4-flash:free,openai/gpt-oss-120b:free,openrouter/free
OPENROUTER_MAX_MODEL_ATTEMPTS=4

# 6. Whitelist allowed WhatsApp numbers (comma-separated, without country prefix + or spaces, e.g., 1234567890,9876543210)
ALLOWED_NUMBERS=

# 7. Sophie Gateway Setup
SOPHIE_TOOL_MODE=gateway
